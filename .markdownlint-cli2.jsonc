{
  "config": {
    "MD013": false, // line length — prose is wrapped by editors, not by hand
    "MD060": false, // table cell padding
    "MD041": false, // AGENTS.md opens with a blockquote, not an H1
    "MD033": false, // inline HTML is used deliberately in docs
    "MD025": false  // CLAUDE.md keeps the /init title plus the working-agreement H1
  },
  "globs": ["**/*.md"],
  "ignores": [
    // Vendored or machine-generated — not ours to reformat.
    "architecture/architecture-portal/**",
    "planning/_bmad/**",
    "planning/_bmad-output/**",
    "**/.agents/**",
    "**/.claude/**",
    "archived/**",
    "node_modules/**",

    // Regenerated by bmad-project-context; edits inside the managed block are
    // replaced on refresh, so linting them only churns.
    "CLAUDE.md",
    "AGENTS.md",

    // Pre-existing violations, excluded so the gate can land green.
    // TODO: clean these up and drop the exclusions.
    "planning/docs/growthhack-source-brief.md",
    "planning/docs/decisions/decision-log.md",
    ".github/HOW_TO_CREATE_EPICS_AND_STORIES.md"
  ]
}
