{
    "openapi": "3.0.3",
    "info": {
        "title": "Architecture Portal APIs"
    },
    "servers": [
        {
            "url": "https://functions-dev.aexp.com/api/v1/",
            "description": "Dev"
        },
        {
            "url": "https://functions-qa.aexp.com/api/v1/",
            "description": "QA"
        },
        {
            "url": "https://functions.aexp.com/api/v1",
            "description": "Prod"
        }
    ],
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "paths": {
        "/companyDomains": {
            "get": {
                "tags": ["Company Domain APIs"],
                "summary": "Get all company domains",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of company domains",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Company Domain List retrieved successfully"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string",
                                                        "example": "8b600406-0142-45b3-b812-2d810d578c05"
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "MYCA - Web"
                                                    },
                                                    "description": {
                                                        "type": "string",
                                                        "example": "Company Domain Description."
                                                    },
                                                    "shortName": {
                                                        "type": "string",
                                                        "example": "myca-web"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/companyDomains/{domainId}": {
            "get": {
                "tags": ["Company Domain APIs"],
                "summary": "Get details for a specific company domain",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "domainId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Company domain details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Company Domain Details Fetched Successfully"
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string",
                                                    "example": "12345"
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "Domain 1"
                                                },
                                                "description": {
                                                    "type": "string",
                                                    "example": "Domain Description"
                                                },
                                                "unitCIO": {
                                                    "type": "string",
                                                    "example": "Domain Unit CIO"
                                                },
                                                "techOwnerEmail": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    },
                                                    "example": [
                                                        "Domain Tech Owner Email"
                                                    ]
                                                },
                                                "unitCIODelegateEmail": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    },
                                                    "example": [
                                                        "Domain Unit CIO Delegate Email"
                                                    ]
                                                },
                                                "enterpriseArchitectEmail": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    },
                                                    "example": [
                                                        "Domain EA Architect Email"
                                                    ]
                                                },
                                                "headEngineerEmail": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    },
                                                    "example": [
                                                        "Domain Head Engineer Email"
                                                    ]
                                                },
                                                "principalArchitectEmail": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    },
                                                    "example": [
                                                        "Domain Principal Architect Email"
                                                    ]
                                                },
                                                "mappedApplicationCount": {
                                                    "type": "integer",
                                                    "example": 10
                                                }
                                            }
                                        }
                                    },
                                    "example": {
                                        "message": "Company Domain Details Fetched Successfully",
                                        "data": {
                                            "id": "12345",
                                            "name": "Domain 1",
                                            "description": "Domain Description",
                                            "unitCIO": "Domain Unit CIO",
                                            "techOwnerEmail": [
                                                "Domain Tech Owner Email"
                                            ],
                                            "unitCIODelegateEmail": [
                                                "Domain Unit CIO Delegate Email"
                                            ],
                                            "enterpriseArchitectEmail": [
                                                "Domain EA Architect Email"
                                            ],
                                            "headEngineerEmail": [
                                                "Domain Head Engineer Email"
                                            ],
                                            "principalArchitectEmail": [
                                                "Domain Principal Architect Email"
                                            ],
                                            "mappedApplicationCount": 10
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/companyDomains/{domainId}/applications": {
            "get": {
                "tags": ["Company Domain APIs"],
                "summary": "Get applications for a specific company domain",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "domainId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Applications for the domain",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "example": {
                                        "message": "Applications mapped to Company Domain retrieved successfully",
                                        "data": [
                                            {
                                                "applicationId": "12345",
                                                "applicationName": "Example Application"
                                            }
                                        ]
                                    },
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Applications mapped to Company Domain retrieved successfully"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "applicationId": {
                                                        "type": "string",
                                                        "example": "12345"
                                                    },
                                                    "applicationName": {
                                                        "type": "string",
                                                        "example": "Example Application"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
