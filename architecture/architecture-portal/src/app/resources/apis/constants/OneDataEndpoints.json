        "/companyDomains/{domainId}/apis/count": {
            "get": {
                "tags": ["Company Domain APIs"],
                "summary": "Get API count for a specific company domain",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "domainId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "API count for the domain",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "example": {
                                        "message": "Domain APIs Fetched Successfully",
                                        "count": 2
                                    },
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Company Domain API List retrieved successfully"
                                        },
                                        "count": {
                                            "type": "number",
                                            "example": 2
                                        }
                                    }
                                }
                            }
                        }
                    }
