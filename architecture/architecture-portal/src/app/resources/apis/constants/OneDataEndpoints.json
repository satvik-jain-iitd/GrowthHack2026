        "/applications/{carId}/company-domain": {
            "get": {
                "tags": ["Company Domain APIs"],
                "summary": "Get company domain for application",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "carId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Mapping retrieved Successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "example": {
                                        "message": "Mapping retrieved Successfully",
                                        "applicationId": "600002899",
                                        "domain": "Foundational Technologies",
                                        "domainId": "746259db-b86f-4a8b-b38d-5cad02596f29"
                                    },
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Status message of the response."
                                        },
                                        "applicationId": {
                                            "type": "string",
                                            "description": "The application Id for which the domain mapping was retrieved."
                                        },
                                        "domain": {
                                            "type": "string",
                                            "description": "The name of the mapped domain."
                                        },
                                        "domainId": {
                                            "type": "string",
                                            "description": "The unique identifier of the mapped domain."
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
